# vim: syntax=bash
fpath=(/usr/local/share/zsh-completions ${fpath})

#eval "$(/opt/homebrew/bin/brew shellenv)"

alias brew-up="brew update && brew upgrade --greedy && brew upgrade --cask --greedy && brew autoremove && brew cleanup --prune=all"
alias envconfig="${EDITOR} ~/.env.mine"
alias gpaat="git remote | xargs -L1 git push --all && git remote | xargs -L1 git push --tags"
alias ll="ls -laFG" # Showing all files (with indicators) and colouring them in list
alias vim="nvim"
#alias pip3-up="pip3 freeze --local | grep -v '^\-e' | cut -d = -f 1 | xargs -n1 pip3 install -U"
alias tailf="tail -f"
alias sail="[ -f sail ] && bash sail || bash vendor/bin/sail"
alias cat="bat"

function activate()
{
    [ -d env ] && source env/bin/activate
    [ -d venv ] && source venv/bin/activate
    [ -d .venv ] && source .venv/bin/activate
}

